<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HotelReservation.About"
             Title="About"
             NavigationPage.HasNavigationBar="False">
  <ContentPage.Resources>
    <Style TargetType="Label" x:Key="LabelStyle">
      <Setter Property="HorizontalTextAlignment" Value="Center"/>
    </Style>
  </ContentPage.Resources>
  
  <VerticalStackLayout
    Padding="20"
    Spacing="20">
    <Label
      Text="Hotel Reservation App"
      Style="{StaticResource LabelStyle}"
      FontSize="28"/>

    <Label
      Text="Aplicativo de reserva de quartos de hotel."
      Style="{StaticResource LabelStyle}"/>

    <Label
      Text="Projeto desenvolvido com .NET MAUI para o curso técnico de Desenvolvimento de Sistemas do Centro Paula Souza."
      Style="{StaticResource LabelStyle}"/>

    <Label
      Text="Copyright © 2025 André Alves."
      Style="{StaticResource LabelStyle}"/>

    <Button
      Text="Voltar à reserva de quartos"
      Clicked="Button_Clicked"
      Background="#FF7125FD"
      TextColor="White"/>
  </VerticalStackLayout>
</ContentPage>
